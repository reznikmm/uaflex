with "config/uaflex_config.gpr";
project Uaflex is

   for Source_Dirs use ("source/**", "config/");
   for Object_Dir use ".obj/" & Uaflex_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("uaflex-driver.adb");

   package Compiler is
      for Default_Switches ("Ada") use Uaflex_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Executable ("uaflex-driver.adb") use "uaflex";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Uaflex;
