------------------------------------------------------------------

D              [0-9]
ID             [a-zA-Z_][a-zA-Z0-9_]*
%x STR
%%
{D}+                 {Number}
{ID}                 {Ident}
"--"[^\n]*           {Comment}
"<="|">="|"/=" {Compare}
"a-b/c"              {Quoted}
\.\.                 {Range}
\\n                  {Backslash}
\t+                  {Tab}
[+\-*/]              {Op}
[^"\n\\]+            {Plain}
\p{Lu}\p{Ll}*        {Word}
\P{L}                {NonLetter}
(ab|cd)*e            {Group}
<STR>[^"]*           {InStr}
%%
